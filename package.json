{
  "name": "ttgame",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "大玉トマト農園シミュレーションRPG (Webブラウザ MVP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"*.{ts,html,md,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
